# Primary CTA. If set, "Apply to drive" links here (new tab). If empty, the waitlist form opens.
VITE_APPLY_URL=

# Waitlist form endpoint (POST JSON: { name, phone, city, lang }). Leave empty in dev to log only.
VITE_WAITLIST_ENDPOINT=

# Canonical site URL for hreflang / og:url (no trailing slash).
VITE_SITE_URL=
