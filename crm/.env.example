# Copy this file to ".env" (same folder as package.json) and fill in the values.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for the Admin page (invite / remove users) when running `netlify dev`.
# NEVER put this in a VITE_ variable and never commit it. Supabase -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
